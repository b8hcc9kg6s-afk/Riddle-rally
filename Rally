<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classroom Riddle Rally Builder & Game</title>
    <!-- Tailwind CSS for styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti for completion celebration -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen font-sans flex flex-col">

    <!-- Header & Navigation -->
    <header class="bg-indigo-600 text-white shadow-lg py-5 px-4">
        <div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
            <div>
                <h1 class="text-2xl font-black tracking-tight flex items-center gap-2">
                    🧩 Classroom Riddle Rally
                </h1>
                <p class="text-indigo-200 text-xs mt-1">Create, solve, and reveal secret target locations!</p>
            </div>
            <div class="flex gap-2">
                <button id="btn-builder" onclick="switchMode('builder')" class="px-4 py-2 bg-indigo-800 text-white text-sm font-semibold rounded-lg shadow">🛠️ Builder Mode</button>
                <button id="btn-play" onclick="switchMode('play')" class="px-4 py-2 bg-indigo-500 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow">🎮 Play Rally</button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-4xl w-full mx-auto p-4 sm:p-6">

        <!-- ================= BUILDER MODE ================= -->
        <section id="builder-mode" class="space-y-6">
            <!-- Target Location Setup -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <h2 class="text-lg font-bold text-slate-900 border-b pb-2">1. Target Location Setup</h2>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Secret Target Location (e.g. LIBRARY, PARK):</label>
                    <input type="text" id="targetLocation" value="PARK" maxlength="10" class="w-full sm:w-64 px-4 py-2 border rounded-lg font-bold uppercase text-lg focus:ring-2 focus:ring-indigo-500 outline-none">
                    <p class="text-xs text-slate-500 mt-1">Each puzzle station reveals one letter of this secret word upon completion!</p>
                </div>
            </div>

            <!-- Stations Configuration -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-6">
                <h2 class="text-lg font-bold text-slate-900 border-b pb-2">2. Configure 5 Interactive Riddle Stations</h2>
                
                <div class="space-y-6">
                    <!-- Station 1: Crossword -->
                    <div class="p-4 bg-slate-50 border rounded-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-indigo-600">Station 1: Mini Crossword</span>
                            <span class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-2 py-1 rounded">Letter #1</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Clue Across:</label>
                                <input type="text" id="s1-clue" value="Opposite of day" class="w-full px-3 py-2 border rounded-lg text-sm bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Target Answer (5 letters):</label>
                                <input type="text" id="s1-ans" value="NIGHT" maxlength="5" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-wider">
                            </div>
                        </div>
                    </div>

                    <!-- Station 2: Sliding Tile Puzzle -->
                    <div class="p-4 bg-slate-50 border rounded-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-indigo-600">Station 2: Sliding Tile Puzzle</span>
                            <span class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-2 py-1 rounded">Letter #2</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Hidden Clue (Uncovered after sliding tiles):</label>
                                <input type="text" id="s2-clue" value="What has hands but cannot clap?" class="w-full px-3 py-2 border rounded-lg text-sm bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Answer:</label>
                                <input type="text" id="s2-ans" value="CLOCK" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-wider">
                            </div>
                        </div>
                    </div>

                    <!-- Station 3: Substitution Cipher -->
                    <div class="p-4 bg-slate-50 border rounded-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-indigo-600">Station 3: Cipher Wheel</span>
                            <span class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-2 py-1 rounded">Letter #3</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Encrypted Code (Shift +3):</label>
                                <input type="text" id="s3-clue" value="FRGH" class="w-full px-3 py-2 border rounded-lg text-sm bg-white font-mono uppercase">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Decoded Secret Word:</label>
                                <input type="text" id="s3-ans" value="CODE" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-wider">
                            </div>
                        </div>
                    </div>

                    <!-- Station 4: Word Scramble -->
                    <div class="p-4 bg-slate-50 border rounded-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-indigo-600">Station 4: Vocabulary Scramble</span>
                            <span class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-2 py-1 rounded">Letter #4</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Scrambled Word:</label>
                                <input type="text" id="s4-clue" value="OCOLH" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-widest">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Unscrambled Word Answer:</label>
                                <input type="text" id="s4-ans" value="SCHOOL" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-wider">
                            </div>
                        </div>
                    </div>

                    <!-- Station 5: Logic Trivia -->
                    <div class="p-4 bg-slate-50 border rounded-xl space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-indigo-600">Station 5: Logic Trivia</span>
                            <span class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-2 py-1 rounded">Letter #5</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Logic Question:</label>
                                <input type="text" id="s5-clue" value="If 5 cats catch 5 mice in 5 minutes, how many cats are needed to catch 100 mice in 100 minutes?" class="w-full px-3 py-2 border rounded-lg text-sm bg-white">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Numerical or Word Answer:</label>
                                <input type="text" id="s5-ans" value="5" class="w-full px-3 py-2 border rounded-lg text-sm bg-white uppercase font-bold tracking-wider">
                            </div>
                        </div>
                    </div>
                </div>

                <button onclick="saveAndStart()" class="w-full py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-xl shadow transition">Save Rally & Test Play 🎉</button>
            </div>
        </section>

        <!-- ================= PLAY MODE ================= -->
        <section id="play-mode" class="hidden space-y-6">
            <!-- Progress Banner -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 text-center space-y-4">
                <h2 class="text-xl font-extrabold text-slate-900">Secret Target Location</h2>
                <div id="targetDisplay" class="flex justify-center gap-2">
                    <!-- Target letter slots populated dynamically -->
                </div>
                <p id="rallyStatusText" class="text-xs text-slate-500">Solve station puzzles to reveal the location letters!</p>
            </div>

            <!-- Active Station Area -->
            <div id="activeStationContainer" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <!-- Dynamically populated station UI -->
            </div>
        </section>

    </main>

    <!-- JS Logic -->
    <script>
        let config = {
            target: "PARK",
            stations: [
                { type: "crossword", clue: "Opposite of day", answer: "NIGHT" },
                { type: "tile", clue: "What has hands but cannot clap?", answer: "CLOCK" },
                { type: "cipher", clue: "FRGH", answer: "CODE" },
                { type: "scramble", clue: "OCOLH", answer: "SCHOOL" },
                { type: "logic", clue: "If 5 cats catch 5 mice in 5 minutes, how many cats catch 100 mice in 100 minutes?", answer: "5" }
            ]
        };

        let activeStation = 0;
        let solved = [false, false, false, false, false];

        // Sliding Tile State for Station 2
        let tileState = [1, 2, 3, 4, 0, 5, 6, 7, 8]; // 0 represents empty slot

        function switchMode(mode) {
            if (mode === 'builder') {
                document.getElementById('builder-mode').classList.remove('hidden');
                document.getElementById('play-mode').classList.add('hidden');
                document.getElementById('btn-builder').className = "px-4 py-2 bg-indigo-800 text-white text-sm font-semibold rounded-lg shadow";
                document.getElementById('btn-play').className = "px-4 py-2 bg-indigo-500 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow";
            } else {
                document.getElementById('builder-mode').classList.add('hidden');
                document.getElementById('play-mode').classList.remove('hidden');
                document.getElementById('btn-play').className = "px-4 py-2 bg-indigo-800 text-white text-sm font-semibold rounded-lg shadow";
                document.getElementById('btn-builder').className = "px-4 py-2 bg-indigo-500 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow";
                initPlayMode();
            }
        }

        function saveAndStart() {
            config.target = document.getElementById('targetLocation').value.trim().toUpperCase() || "PARK";
            config.stations[0].clue = document.getElementById('s1-clue').value;
            config.stations[0].answer = document.getElementById('s1-ans').value.trim().toUpperCase();
            config.stations[1].clue = document.getElementById('s2-clue').value;
            config.stations[1].answer = document.getElementById('s2-ans').value.trim().toUpperCase();
            config.stations[2].clue = document.getElementById('s3-clue').value.trim().toUpperCase();
            config.stations[2].answer = document.getElementById('s3-ans').value.trim().toUpperCase();
            config.stations[3].clue = document.getElementById('s4-clue').value.trim().toUpperCase();
            config.stations[3].answer = document.getElementById('s4-ans').value.trim().toUpperCase();
            config.stations[4].clue = document.getElementById('s5-clue').value;
            config.stations[4].answer = document.getElementById('s5-ans').value.trim().toUpperCase();

            solved = [false, false, false, false, false];
            activeStation = 0;
            switchMode('play');
        }

        function initPlayMode() {
            renderTargetDisplay();
            renderStation();
        }

        function renderTargetDisplay() {
            const container = document.getElementById('targetDisplay');
            container.innerHTML = '';
            for (let i = 0; i < config.target.length; i++) {
                const char = config.target[i];
                const isRevealed = solved[i] || false;
                container.innerHTML += `
                    <div class="w-12 h-14 border-2 ${isRevealed ? 'border-green-500 bg-green-50 text-green-700' : 'border-slate-300 bg-slate-100 text-slate-400'} rounded-xl flex items-center justify-center font-black text-2xl shadow-sm transition-all">
                        ${isRevealed ? char : '?'}
                    </div>
                `;
            }
        }

        function renderStation() {
            const container = document.getElementById('activeStationContainer');
            if (solved.every(s => s === true) || activeStation >= 5) {
                container.innerHTML = `
                    <div class="text-center py-8 space-y-4">
                        <div class="text-6xl">🏆</div>
                        <h3 class="text-2xl font-black text-green-600">Congratulations! Rally Complete!</h3>
                        <p class="text-slate-600">You revealed the target location:</p>
                        <div class="text-4xl font-black text-indigo-600 bg-indigo-50 py-3 rounded-xl border border-indigo-200 tracking-widest">${config.target}</div>
                    </div>
                `;
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                return;
            }

            const st = config.stations[activeStation];
            let html = `
                <div class="space-y-4">
                    <div class="flex justify-between items-center text-xs font-semibold text-slate-500 border-b pb-3">
                        <span>STATION ${activeStation + 1} OF 5</span>
                        <span class="bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full">Unlocks Letter #${activeStation + 1}</span>
                    </div>
            `;

            if (activeStation === 0) {
                // Crossword
                html += `
                    <h3 class="font-bold text-slate-800">Station 1: Mini Crossword</h3>
                    <p class="text-sm text-slate-600"><strong>Clue:</strong> ${st.clue}</p>
                    <div class="flex gap-2 my-4">
                        ${Array.from({length: st.answer.length}).map((_, i) => `<input type="text" maxlength="1" id="cw-${i}" class="w-10 h-12 border-2 border-slate-300 rounded-lg text-center font-bold text-lg uppercase focus:border-indigo-500 outline-none">`).join('')}
                    </div>
                    <button onclick="checkCrossword()" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg text-sm hover:bg-indigo-700">Submit</button>
                `;
            } else if (activeStation === 1) {
                // Sliding Tile
                html += `
                    <h3 class="font-bold text-slate-800">Station 2: Sliding Tile Puzzle</h3>
                    <p class="text-xs text-slate-500">Arrange tiles in numerical order (1-8) to reveal the hidden clue!</p>
                    <div class="grid grid-cols-3 gap-2 w-48 mx-auto my-4 bg-slate-200 p-2 rounded-xl" id="tileBoard">
                        ${renderTiles()}
                    </div>
                    <div id="tileClueContainer" class="hidden p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-900 font-medium">
                        🔓 <strong>Clue Revealed:</strong> ${st.clue}
                    </div>
                    <div class="mt-3 flex gap-2">
                        <input type="text" id="s2-input" placeholder="Enter answer..." class="flex-grow px-3 py-2 border rounded-lg uppercase font-bold text-sm">
                        <button onclick="checkAnswer('s2-input', '${st.answer}')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg text-sm hover:bg-indigo-700">Submit</button>
                    </div>
                `;
            } else if (activeStation === 2) {
                // Cipher
                html += `
                    <h3 class="font-bold text-slate-800">Station 3: Cipher Wheel</h3>
                    <p class="text-sm text-slate-600">Decode the shift cipher code: <strong class="font-mono text-indigo-600 bg-indigo-50 px-2 py-1 rounded">${st.clue}</strong> (Shift: -3)</p>
                    <div class="mt-3 flex gap-2">
                        <input type="text" id="s3-input" placeholder="Decoded word..." class="flex-grow px-3 py-2 border rounded-lg uppercase font-bold text-sm">
                        <button onclick="checkAnswer('s3-input', '${st.answer}')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg text-sm hover:bg-indigo-700">Submit</button>
                    </div>
                `;
            } else if (activeStation === 3) {
                // Scramble
                html += `
                    <h3 class="font-bold text-slate-800">Station 4: Word Scramble</h3>
                    <p class="text-sm text-slate-600">Unscramble this word: <strong class="tracking-widest text-indigo-600 bg-indigo-50 px-2 py-1 rounded">${st.clue}</strong></p>
                    <div class="mt-3 flex gap-2">
                        <input type="text" id="s4-input" placeholder="Unscrambled word..." class="flex-grow px-3 py-2 border rounded-lg uppercase font-bold text-sm">
                        <button onclick="checkAnswer('s4-input', '${st.answer}')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg text-sm hover:bg-indigo-700">Submit</button>
                    </div>
                `;
            } else if (activeStation === 4) {
                // Logic
                html += `
                    <h3 class="font-bold text-slate-800">Station 5: Logic Trivia</h3>
                    <p class="text-sm text-slate-600">${st.clue}</p>
                    <div class="mt-3 flex gap-2">
                        <input type="text" id="s5-input" placeholder="Your answer..." class="flex-grow px-3 py-2 border rounded-lg uppercase font-bold text-sm">
                        <button onclick="checkAnswer('s5-input', '${st.answer}')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-lg text-sm hover:bg-indigo-700">Submit</button>
                    </div>
                `;
            }

            html += `<p id="feedback" class="text-xs font-bold pt-2"></p></div>`;
            container.innerHTML = html;
        }

        function checkCrossword() {
            const ans = config.stations[0].answer;
            let user = "";
            for(let i = 0; i < ans.length; i++) {
                const el = document.getElementById(`cw-${i}`);
                user += el ? el.value.toUpperCase() : "";
            }
            if(user === ans) {
                completeStation();
            } else {
                showFeedback(false);
            }
        }

        function renderTiles() {
            return tileState.map((val, idx) => {
                if (val === 0) return `<div class="w-12 h-12 bg-slate-300 rounded-lg"></div>`;
                return `<button onclick="moveTile(${idx})" class="w-12 h-12 bg-indigo-600 text-white font-bold text-lg rounded-lg shadow active:scale-95 transition">${val}</button>`;
            }).join('');
        }

        function moveTile(idx) {
            const emptyIdx = tileState.indexOf(0);
            const validMoves = [idx - 1, idx + 1, idx - 3, idx + 3];
            if (validMoves.includes(emptyIdx)) {
                tileState[emptyIdx] = tileState[idx];
                tileState[idx] = 0;
                document.getElementById('tileBoard').innerHTML = renderTiles();
                if (tileState.slice(0, 8).every((val, i) => val === i + 1)) {
                    document.getElementById('tileClueContainer').classList.remove('hidden');
                }
            }
        }

        function checkAnswer(inputId, correctAns) {
            const user = document.getElementById(inputId).value.trim().toUpperCase();
            if (user === correctAns) {
                completeStation();
            } else {
                showFeedback(false);
            }
        }

        function completeStation() {
            showFeedback(true);
            solved[activeStation] = true;
            renderTargetDisplay();
            setTimeout(() => {
                activeStation++;
                renderStation();
            }, 1000);
        }

        function showFeedback(isCorrect) {
            const fb = document.getElementById('feedback');
            if(fb) {
                fb.className = isCorrect ? "text-xs font-bold text-green-600 pt-2" : "text-xs font-bold text-red-500 pt-2";
                fb.textContent = isCorrect ? "Correct! Unlocking next station..." : "Incorrect! Try again.";
            }
        }
    </script>
</body>
</html>
